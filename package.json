{
	"name": "obsidian-archify-preview",
	"version": "0.1.2",
	"description": "在 Obsidian 中点击 Archify 缩略图，交互式预览自包含 HTML 架构图。",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"keywords": [
		"obsidian",
		"archify",
		"html-preview"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"esbuild": "^0.20.0",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.4.0"
	}
}
